# Google Gemini API Key (Get yours free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gcp_api_key_here
# Gemini Model name (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-3.5-flash

# Port for the Express server (default: 3000)
PORT=3000
